.venv/
Genesis/utilities/__pycache__/*
Genesis/training/__pycache__/*
Genesis/training/__pycache__/dataset.cpython-310.pyc
Genesis/examples/__pycache__/*
Genesis/__pycache__/*
GranularDynamics2/myClasses/__pycache__/*
GranularDynamics2/__pycache__/*

# Catch-all; the per-directory entries above predate it.
__pycache__/

# Collected datasets and generated run artefacts. Reproducible from the
# configs and seeds recorded alongside them.
# Collected datasets. Genesis/data/ is where every collection lands
# (--output-root is relative to Genesis/), so ignore the whole tree rather than
# naming run directories one at a time - the previous list missed every new
# name, which is exactly how a multi-GB dataset gets committed by accident.
# Nothing under it is tracked.
Genesis/data/
Genesis/layered/data/
MPC/data/
MPC/mpc_transitions/
outputs/

# Rendered inspection videos. Regenerate with
#   python tests/scaling_investigation/record_simulation_video.py
# The measured numbers alongside them (results/*.json) ARE tracked; the frames
# are megabytes of binary that say nothing a re-render would not.
tests/scaling_investigation/results/video/
